# Yerel geliştirme için — gerçek değerler apps/web/.env dosyasına (gitignore'da,
# asla commit edilmez) yazılır. Kurulum için bkz. kök README.md "Yerel Geliştirme".

# app_role: RLS'e tam tabi bağlantı (bkz. prisma/rls/README.md).
DATABASE_URL="postgresql://app_role:app_role_dev_only@localhost:5432/seviye360?schema=public"

# superadmin_role: yalnızca SUPERADMIN için BYPASSRLS bağlantısı (bkz. lib/db-context.ts).
SUPERADMIN_DATABASE_URL="postgresql://superadmin_role:superadmin_dev_only@localhost:5432/seviye360?schema=public"

# Oturum JWT'lerini imzalamak için kullanılır (bkz. lib/auth.ts). En az 32
# karakter olmalıdır — daha kısaysa veya "dev-only"/"changeme"/"secret" gibi
# bariz bir placeholder içerip NODE_ENV=production ise uygulama başlamaz.
#
# ÜRETİMDE: bu değeri asla bir .env dosyasına yazıp deploy etmeyin — bir
# secret yöneticisinden (AWS Secrets Manager, HashiCorp Vault, Doppler, ...)
# ortam değişkeni olarak enjekte edin. Yerelde hızlıca rastgele bir değer
# üretmek için: `openssl rand -base64 48`
JWT_SECRET="dev-only-jwt-secret-do-not-use-in-production-cbYVvN3q8"
