// Seviye 360 — Çekirdek Veri Modeli
//
// Multi-tenant izolasyon stratejisi: Her satır-bazlı (row-level) tenant'a
// bağlı tablo bir `tenantId` taşır. PostgreSQL üzerinde bu şema, her tabloda
// `ENABLE ROW LEVEL SECURITY` + `tenant_isolation` politikasıyla (bkz.
// prisma/rls/README.md) korunur; uygulama katmanı her istek başında
// `SET LOCAL app.tenant_id = '<tenantId>'` çalıştırır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// SINIF DÜZEYİ TAKSONOMİSİ
// ---------------------------------------------------------------------------
//
// Kurum genelinde tek, sabit bir sınıf düzeyi listesi. Classroom.gradeLevel
// ve Enrollment.candidateGradeLevel bu enum'u kullanır; StudentProfile de
// (henüz bir şubeye/bölüme atanmamış olsa dahi) doğrudan bir gradeLevel
// taşır — "Sınıf Atama" ekranı, gradeLevel'ı sabit tutup yalnızca classroomId'yi
// (örn. "9-A") değiştirir.

enum GradeLevel {
  ANASINIFI_3_YAS
  ANASINIFI_4_YAS
  ANASINIFI_5_YAS
  SINIF_1
  SINIF_2
  SINIF_3
  SINIF_4
  SINIF_5
  SINIF_6
  SINIF_7
  SINIF_8
  SINIF_9
  SINIF_10
  SINIF_11
  SINIF_12
  MEZUN
}

// ---------------------------------------------------------------------------
// TENANT / HİYERARŞİ (Genel Merkez -> Şube -> Bölüm)
// ---------------------------------------------------------------------------

enum TenantType {
  GENEL_MERKEZ
  SUBE
  BOLUM
}

model Tenant {
  id       String     @id @default(cuid())
  name     String // örn. "Özel Mezitli Seviye Anadolu Lisesi"
  code     String     @unique // örn. "MEZITLI-01"
  type     TenantType
  city     String?
  district String?

  // Kurum Yönetimi'nin "Yeni Kurum Ekle" formu için (bkz. app/api/hq/tenants) —
  // demo'daki tüm alanları bilinçli olarak taşımaz (managerName/managerPhone
  // gibi alanlar gerçek backend'de User.firstName/lastName/phone'un bir
  // KOPYASI olurdu, bu yüzden eklenmedi — şube müdürünün gerçek adı/telefonu
  // tek kaynaktan, kendi User kaydından okunur).
  address  String?
  phone    String?
  email    String?
  capacity Int?
  taxNo    String?

  // "Kurum Türü" (demo'daki KURUM_TURU_OPTIONS listesi — bkz. lib/api/hq.ts
  // KURUM_TURU_OPTIONS) ve "Açılış Tarihi" — sadece bilgi amaçlı, herhangi bir
  // iş kuralını etkilemez, bu yüzden serbest metin/tarih olarak tutulur.
  kurumTuru   String?
  openingDate DateTime?

  parentId String?
  parent   Tenant?  @relation("TenantHierarchy", fields: [parentId], references: [id])
  children Tenant[] @relation("TenantHierarchy")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                     User[]
  classrooms                Classroom[]
  studentProfiles           StudentProfile[]
  enrollments               Enrollment[]
  crmLeads                  CrmLead[]
  exams                     Exam[]
  examResults               ExamResult[]
  studySessions             StudySession[]
  paymentInstallments       PaymentInstallment[]
  paymentMethods            PaymentMethod[]
  paymentReceipts           PaymentReceipt[]
  ledgerEntries             AccountingLedgerEntry[]
  payrollRecords            PayrollRecord[]
  staffProfiles             StaffProfile[]
  invoices                  Invoice[]
  receipts                  Receipt[]
  promissoryNotes           PromissoryNote[]
  attendanceRecords         AttendanceRecord[]
  disciplineRecords         DisciplineRecord[]
  ptaMeetingRequests        PtaMeetingRequest[]
  clubs                     Club[]
  auditLogEntries           AuditLogEntry[]
  busRoutes                 BusRoute[]
  quizAttempts              QuizAttempt[]
  messages                  Message[]
  messageTemplates          MessageTemplate[]
  mentorRequests            MentorRequest[]
  timetableSlots            TimetableSlot[]
  examBranchDispatches      ExamBranchDispatch[]
  institutionPaymentMethods InstitutionPaymentMethod[]

  @@index([parentId])
}

// ---------------------------------------------------------------------------
// KULLANICI / ROLLER
// ---------------------------------------------------------------------------

enum UserRole {
  SUPERADMIN
  BRANCH_ADMIN
  GUIDANCE_COORDINATOR
  ACCOUNTING
  TEACHER
  STUDENT
  PARENT
}

model User {
  id       String  @id @default(cuid())
  tenantId String? // SUPERADMIN için null olabilir (Genel Merkez kullanıcısı)
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  email        String   @unique
  // Global @unique DEĞİL — tenant başına benzersiz. Global olsaydı bir
  // BRANCH_ADMIN, veli/personel telefonu güncellerken rastgele numaralar
  // deneyip 409/200 yanıtından BAŞKA bir şubenin kayıtlı telefon numaralarını
  // teşhis edebilirdi (cross-tenant existence oracle) — ayrıca aynı veli iki
  // farklı şubede kayıtlıysa (iki ayrı User satırı) aynı telefonu kullanamazdı.
  phone        String?
  passwordHash String
  role         UserRole
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherProfile TeacherProfile?
  staffProfile   StaffProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  sessions       UserSession[]

  sentMessages      Message[]
  messageRecipients MessageRecipient[]

  @@unique([tenantId, phone])
  @@index([tenantId, role])
}

// Her başarılı login bir satır oluşturur (JWT'nin `jti` alanı bu satırın id'sidir).
// Token'ın kendisi imzalı olsa da hangi oturumların hâlâ geçerli olduğuna dair
// tek gerçek kaynak burasıdır — bu sayede çalınmış/eski bir token, süresi
// dolmadan da (logout veya logout-all ile) iptal edilebilir.
model UserSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model TeacherProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branch String // örn. "Matematik", "Fizik" (zümre)
  title  String? // örn. "Zümre Başkanı"

  // Seviye Mentör — bu öğretmenin mentör havuzunda olup olmadığı (bkz.
  // app/api/branch/teachers/[teacherId]/mentor). Demo'daki gibi ayrı bir
  // "Mentör Öğretmen" personel rolü değil, mevcut bir öğretmenin ek bir
  // görevi olarak modellenir — BRANCH_ADMIN tarafından açılıp kapatılır.
  isMentor Boolean @default(false)

  availabilitySlots  TeacherAvailabilitySlot[]
  studySessions      StudySession[]
  payrollRecords     PayrollRecord[]
  ptaMeetingRequests PtaMeetingRequest[]
  advisedClubs       Club[]
  mentees            StudentProfile[]
  mentorRequests     MentorRequest[]
  timetableSlots     TimetableSlot[]

  @@index([branch])
}

// Öğretmen dışı personel (Şube Müdürü, Ön Büro Görevlisi, Muhasebe Görevlisi,
// Rehber Öğretmen vb.) — TeacherProfile'dan bilinçli olarak ayrı: öğretmene
// özgü alanlar (branch/zümre, availabilitySlots, studySessions) burada
// anlamsız olurdu. TeacherProfile'ın aksine (bkz. apps/web/app/api/branch/payroll
// route'undaki not — o tabloda tenant'a göre RLS YOK) burada `tenantId` doğrudan
// tutulur ve PayrollRecord/AccountingLedgerEntry ile AYNI rol-kısıtlı RLS
// politikasını taşır — maaş içerdiği için yalnızca SUPERADMIN/BRANCH_ADMIN/
// ACCOUNTING görebilir (bkz. prisma/rls/README.md).
// Aktif/İzinli hâlâ giriş yapabilir (User.isActive=true); Ayrıldı, Devre
// Dışı Bırak (soft-delete) ile aynı anda User.isActive=false yapar — bkz.
// app/api/branch/staff/[staffId] PATCH'teki status<->isActive senkronizasyonu.
enum StaffStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
}

model StaffProfile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String // örn. "Şube Müdürü", "Ön Büro Görevlisi", "Muhasebe Görevlisi", "Rehber Öğretmen"
  department String? // örn. "Rehberlik", "İdari İşler"
  startDate  DateTime
  salary     Decimal     @db.Decimal(10, 2)
  status     StaffStatus @default(ACTIVE)

  payrollRecords PayrollRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model StudentProfile {
  id       String @id @default(cuid())
  tenantId String // RLS scoping için doğrudan tutulur (bkz. prisma/rls/README.md)
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gradeLevel  GradeLevel // kayıt sırasında belirlenir; şube ataması sonrasında da sabit kalır
  classroomId String? // "Sınıf Atama" ekranıyla doldurulur (örn. "9-A"); null ise henüz bir şubeye atanmamıştır
  classroom   Classroom? @relation(fields: [classroomId], references: [id])

  busRouteId String? // Servis/Ulaşım Takibi — bir öğrenci en fazla BİR güzergaha atanabilir
  busRoute   BusRoute? @relation(fields: [busRouteId], references: [id])

  // Seviye Mentör — BusRoute ile aynı desen (tekli nullable FK, join tablosu
  // değil): bir öğrencinin en fazla BİR mentörü olur, ilk erişimde round-robin
  // (en az mentisi olan mentöre) otomatik atanır — bkz. app/api/students/[studentId]/mentor.
  mentorTeacherId String?
  mentorTeacher   TeacherProfile? @relation(fields: [mentorTeacherId], references: [id])
  mentorRequests  MentorRequest[]

  targetGoal String? // örn. "Tıp Fakültesi"
  studentNo  String  @unique

  // Normal Kayıt tamamlama formu (demo'daki nk-tc/nk-dogum/nk-cinsiyet
  // alanları, bkz. app/api/branch/enrollments/[enrollmentId]/complete) —
  // hepsi opsiyonel, kayıt tamamlanırken girilmezse boş kalır.
  nationalId String?   @unique // T.C. Kimlik No, 11 hane
  birthDate  DateTime?
  gender     String? // demo ile birebir: "Kadın" | "Erkek"

  guardians          StudentGuardian[]
  examResults        ExamResult[]
  achievementRows    StudentAchievementResult[]
  studySessions      StudySession[]
  installments       PaymentInstallment[]
  paymentMethods     PaymentMethod[]
  paymentReceipts    PaymentReceipt[]
  enrollment         Enrollment?
  promissoryNotes    PromissoryNote[]
  attendanceRecords  AttendanceRecord[]
  disciplineRecords  DisciplineRecord[]
  ptaMeetingRequests PtaMeetingRequest[]
  clubMemberships    ClubMembership[]
  quizAttempts       QuizAttempt[]

  @@index([classroomId])
  @@index([gradeLevel])
}

model ParentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  students StudentGuardian[]
}

// Bir öğrencinin birden fazla velisi, bir velinin birden fazla öğrencisi olabilir.
model StudentGuardian {
  studentId            String
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId             String
  parent               ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relation             String // örn. "Anne", "Baba", "Vasi"
  isBillingResponsible Boolean        @default(false)

  @@id([studentId, parentId])
}

model Classroom {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name       String // örn. "9-A" (şube içindeki fiziksel şube/bölüm)
  gradeLevel GradeLevel
  capacity   Int        @default(30) // demo'daki "Kapasite (Sınıf Limiti)" — bkz. app/api/branch/classrooms

  students          StudentProfile[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  timetableSlots    TimetableSlot[]

  @@unique([tenantId, name])
  @@index([tenantId, gradeLevel])
}

// ---------------------------------------------------------------------------
// DERS PROGRAMI
// ---------------------------------------------------------------------------
//
// demo/seviye360-app.html'deki "schedule" ekranının gerçek karşılığı. Yeni
// bir öğretmen-ders eşleme tablosu YOKTUR — TeacherAvailabilitySlot'la aynı
// dayOfWeek/startTime/endTime konvansiyonunu kullanır, `subject` alanı ise
// TeacherProfile.branch ile aynı serbest metin deseni (bkz. lib/curriculum.ts
// "CurriculumNode'da ayrı bir subject alanı yok" notu — burada da ayrı bir
// Subject modeli eklenmez). Çakışma kontrolü (aynı sınıf/aynı öğretmen aynı
// gün+saatte iki kayıt) uygulama katmanında yapılır (bkz.
// app/api/branch/timetable route'u).
model TimetableSlot {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  classroomId String
  classroom   Classroom      @relation(fields: [classroomId], references: [id])
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])

  subject   String // örn. "Matematik"
  dayOfWeek Int // 0=Pazartesi ... 6=Pazar (TeacherAvailabilitySlot ile aynı konvansiyon)
  startTime String // "09:00"
  endTime   String // "09:40"

  createdAt DateTime @default(now())

  @@index([tenantId, classroomId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
}

// ---------------------------------------------------------------------------
// DEVAMSIZLIK / YOKLAMA
// ---------------------------------------------------------------------------
//
// Diğer akademik tablolar (Exam/ExamResult/Classroom/StudentProfile) gibi
// yalnızca `tenant_isolation` taşır (rol bazlı kısıtlama YOK) — TEACHER/
// BRANCH_ADMIN/GUIDANCE_COORDINATOR yoklama alıp görebilir, STUDENT/PARENT
// yalnızca KENDİ (veya velisi olduğu öğrencinin) kayıtlarını görebilir; bu
// satır bazlı filtre veritabanında değil uygulama katmanında (bkz.
// app/api/students/[studentId]/attendance) yapılır — Muhasebe/Bordro'nun
// aksine, burada hangi SATIRLARIN görünür olduğu role değil KİMLİĞE bağlıdır.

enum AttendanceStatus {
  VAR // Katıldı
  GEC // Geç geldi
  IZINLI // İzinli/mazeretli
  YOK // Katılmadı (devamsız)
}

model AttendanceRecord {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  date   DateTime // gün (saat bileşeni yok sayılır)
  status AttendanceStatus
  note   String?

  recordedByUserId String // yoklamayı alan öğretmen/şube yöneticisinin User.id'si

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([tenantId, date])
  @@index([classroomId, date])
}

// ---------------------------------------------------------------------------
// DİSİPLİN / DAVRANIŞ TAKİBİ
// ---------------------------------------------------------------------------
//
// AttendanceRecord ile aynı desen: yalnızca `tenant_isolation` (rol bazlı
// kısıtlama YOK) — TEACHER/BRANCH_ADMIN/GUIDANCE_COORDINATOR kayıt ekleyip
// tüm öğrencileri görebilir, STUDENT/PARENT yalnızca KENDİ (veya velisi
// olduğu öğrencinin) kayıtlarını görebilir; bu filtre uygulama katmanında
// (bkz. app/api/students/[studentId]/discipline) yapılır.

enum DisciplineType {
  OLUMLU
  OLUMSUZ
}

model DisciplineRecord {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  type     DisciplineType
  category String
  note     String?
  points   Int // OLUMLU: +5, OLUMSUZ: -5 (bkz. app/api/branch/discipline route'undaki sabit)

  recordedByUserId String

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([studentId])
}

enum PtaRequestStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
}

// Veli-Öğretmen Görüşme Randevusu — demo'daki PTA_REQUESTS'in gerçek karşılığı.
// DisciplineRecord/AttendanceRecord ile aynı düz `tenant_isolation` (rol değil
// KİMLİK bazlı görünürlük): PARENT yalnızca kendi talebini, TEACHER yalnızca
// kendisine yöneltilen talepleri, BRANCH_ADMIN/GUIDANCE_COORDINATOR tüm
// tenant'ı görebilir/yönetebilir.
model PtaMeetingRequest {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])

  requestedAt DateTime // velinin talep ettiği görüşme tarihi/saati
  topic       String?
  status      PtaRequestStatus @default(BEKLIYOR)

  requestedByUserId String // talebi oluşturan PARENT kullanıcısı

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([studentId])
  @@index([teacherId, status])
}

// ---------------------------------------------------------------------------
// KAYIT (Ön Kayıt -> Normal Kayıt)
// ---------------------------------------------------------------------------
//
// CRM Kanban'daki "Kayıt Oldu" statüsüne düşen bir aday, burada bir Enrollment
// kaydı olarak somutlaşır. ON_KAYIT aşamasında henüz bir User/StudentProfile
// yoktur (yalnızca aday bilgisi + kapora); NORMAL_KAYIT_TAMAMLANDI aşamasına
// geçtiğinde `studentId` doldurulur ve gerçek StudentProfile oluşturulmuş olur.

enum EnrollmentType {
  ON_KAYIT // Kapora ile yer ayırtma
  NORMAL_KAYIT // Sözleşme + tam kayıt
}

enum EnrollmentStage {
  ON_KAYIT_ALINDI
  SOZLESME_BEKLENIYOR
  ODEME_PLANI_OLUSTURULDU
  KAYIT_TAMAMLANDI
  IPTAL_EDILDI
}

model Enrollment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type  EnrollmentType  @default(ON_KAYIT)
  stage EnrollmentStage @default(ON_KAYIT_ALINDI)

  // Demo'daki KAYIT_TURU_OPTIONS ("Normal Kayıt"/"Deneme Kulübü"/"Yaz Kursu"/
  // "Kış Kursu") ile birebir aynı — yukarıdaki `type` (ON_KAYIT/NORMAL_KAYIT)
  // ile KARIŞTIRILMAMALI: `type` kayıt İŞ AKIŞINI (kapora ile mi doğrudan mı)
  // belirtirken, bu alan hangi PROGRAMA kayıt olunduğunu belirtir.
  programType String @default("Normal Kayıt")

  candidateFullName   String
  candidateGradeLevel GradeLevel
  guardianFullName    String
  guardianPhone       String
  targetClassroomId   String?
  targetClassroom     Classroom? @relation(fields: [targetClassroomId], references: [id])

  depositAmount    Decimal?  @db.Decimal(10, 2) // Ön kayıt kaporası
  contractSignedAt DateTime?

  studentId String?         @unique // Normal kayıt tamamlanınca StudentProfile'a bağlanır
  student   StudentProfile? @relation(fields: [studentId], references: [id])

  crmLead CrmLead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, stage])
}

enum CrmLeadStage {
  ARANDI
  GORUSULDU
  DENEME_SINAVINA_GIRDI
  KAYIT_OLDU
}

// CRM — Ön Kayıt'tan ÖNCEKİ, henüz bir yer ayırtma kaporası ödenmemiş "aday
// havuzu" (demo/seviye360-app.html'deki "branch:crm" Kanban'ının gerçek
// karşılığı, bkz. app/api/branch/crm-leads). Enrollment'tan kasıtlı olarak
// ayrı bir model: bu aşamada henüz finansal bir taahhüt (kapora) yoktur, bu
// yüzden bir CrmLead — Enrollment'ın aksine — gerçekten SİLİNEBİLİR
// (henüz Enrollment'a dönüşmemişse). "KAYIT_OLDU" aşamasına taşındığında
// otomatik olarak bir Enrollment(ON_KAYIT) oluşturulur ve buraya bağlanır
// (bkz. demo'daki not: "Ön kayıt, CRM'de 'Kayıt Oldu' statüsüne düşen
// adaylardan otomatik de oluşabilir").
model CrmLead {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  candidateFullName   String
  candidateGradeLevel GradeLevel
  school              String?
  guardianFullName    String
  guardianPhone       String
  guardianEmail       String?
  notes               String?

  stage CrmLeadStage @default(ARANDI)

  enrollmentId String?     @unique
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, stage])
}

// ---------------------------------------------------------------------------
// MÜFREDAT AĞACI (Kazanımlar)
// ---------------------------------------------------------------------------

enum CurriculumNodeType {
  SUBJECT // Ders (örn. Matematik)
  UNIT // Ünite
  TOPIC // Konu
  ACHIEVEMENT // Kazanım (örn. "MAT.9.1.2.3")
}

model CurriculumNode {
  id         String             @id @default(cuid())
  type       CurriculumNodeType
  code       String             @unique // MEB kazanım kodu
  label      String
  gradeLevel Int

  parentId String?
  parent   CurriculumNode?  @relation("CurriculumHierarchy", fields: [parentId], references: [id])
  children CurriculumNode[] @relation("CurriculumHierarchy")

  examQuestions             ExamQuestion[]
  studentAchievementResults StudentAchievementResult[]
  studySessions             StudySession[]
  quizAttempts              QuizAttempt[]

  @@index([parentId])
  @@index([type, gradeLevel])
}

// ---------------------------------------------------------------------------
// SINAV / SONUÇ
// ---------------------------------------------------------------------------

enum ExamScope {
  BRANCH // Tek şubeye özel
  NETWORK // Genel Merkez tarafından tüm şubelere push edilen "Seviye 360 Deneme Sınavı"
}

enum ExamType {
  DENEME
  YAZILI
  VIP_OLCME
}

enum BookletDispatchStatus {
  HAZIRLANIYOR
  BASILIYOR
  KARGOYA_VERILDI
  TESLIM_EDILDI
}

// "Genel Sınav Merkezi"nde bir NETWORK sınavın hangi şubelere hedeflendiğini
// (demo'daki exam.branchIds) VE o şubeye basılı kitapçık sevkiyat durumunu
// (demo'daki exam.branchDispatch[branchId]) tek bir satırda tutar — bkz.
// app/api/hq/exams POST/PATCH ve .../dispatch route'u.
model ExamBranchDispatch {
  id     String @id @default(cuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  status BookletDispatchStatus @default(HAZIRLANIYOR)

  updatedAt DateTime @updatedAt

  @@unique([examId, tenantId])
  @@index([tenantId])
}

model Exam {
  id       String @id @default(cuid())
  tenantId String // Network sınavlarında bu, sınavı yayınlayan Genel Merkez tenant'ıdır
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name         String
  type         ExamType
  scope        ExamScope
  bookletTypes String[]  @default(["A", "B", "C", "D"])
  examDate     DateTime

  // NETWORK sınavlarında (bkz. app/api/hq/exams — "Genel Sınav Merkezi")
  // öğrenci başına ücret ve hedeflenen sınıf düzeyleri (Ortaokul+Lise) burada
  // saklanır ki optik form ihtiyacı/toplam fatura tutarı her görüntülemede
  // TÜM hedeflenen şubelerdeki canlı StudentProfile sayısına göre yeniden
  // hesaplanabilsin. Hangi şubelerin "davet edildiği" (demo'daki branchIds)
  // branchDispatches üzerinden saklanır — her hedeflenen şube için bir
  // ExamBranchDispatch satırı vardır.
  // BRANCH sınavlarında (bkz. app/api/branch/exams — "Sınav Uygulaması") aynı
  // iki alan öğrenci başına ücret ve sınavın uygulanacağı sınıf düzeyi
  // kapsamı için kullanılır — branchDispatches yoktur (tek tenant zaten
  // sabit), eligibleGradeLevels boşsa (varsayılan) TÜM sınıf düzeyleri dahildir.
  feePerStudent       Decimal?     @db.Decimal(10, 2)
  eligibleGradeLevels GradeLevel[] @default([])

  createdAt DateTime @default(now())

  questions        ExamQuestion[]
  results          ExamResult[]
  branchDispatches ExamBranchDispatch[]

  @@index([tenantId, examDate])
}

model ExamQuestion {
  id     String @id @default(cuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  orderIndex    Int
  achievementId String
  achievement   CurriculumNode @relation(fields: [achievementId], references: [id])

  // Cevap anahtarı — demo'daki ANSWER_KEY_OPTIONS ("A".."E") ile birebir aynı.
  // Sonuç Girişi'nde referans olarak gösterilir; doğru/yanlış/boş işaretlemesi
  // (bkz. app/api/branch/exams/[examId]/results) yine elle girilir — kamera/
  // OCR bazlı otomatik okuma bu depoda kasıtlı olarak kapsam dışıdır.
  correctAnswer String?

  // IRT (Madde Tepki Kuramı) parametreleri
  irtDifficulty     Float? // b parametresi
  irtDiscrimination Float? // a parametresi

  answers ExamResultAnswer[]

  @@unique([examId, orderIndex])
  @@index([achievementId])
}

model ExamResult {
  id        String         @id @default(cuid())
  examId    String
  exam      Exam           @relation(fields: [examId], references: [id])
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  seatingRoomId String?
  seatNo        String?
  bookletType   String?

  correctCount Int
  wrongCount   Int
  emptyCount   Int
  rawScore     Float
  netScore     Float
  percentile   Float?

  achievementResults StudentAchievementResult[]
  answers            ExamResultAnswer[]

  createdAt DateTime @default(now())

  @@unique([examId, studentId])
  @@index([tenantId, examId])
}

// Öğrencinin sınavdaki HER sorusu için Doğru/Yanlış/Boş sonucu — demo'daki
// "Soru Bazlı Değerlendirme" tablosunun (renderAiResultHtml, bkz.
// app/api/students/[studentId]/exam-results) gerçek veri kaynağı. Demo'nun
// kendisi bunu (given: öğrencinin işaretlediği şık) RASTGELE üretiyordu
// (bkz. simulateAnswerSheet) — kamera/OCR bazlı otomatik okuma bu depoda
// kasıtlı olarak kapsam dışı olduğundan, burada UYDURMA bir "given" alanı
// YOKTUR; yalnızca Sonuç Girişi'nde gerçekten elle işaretlenen isCorrect
// (Doğru/Yanlış/Boş) ve ExamQuestion.correctAnswer (gerçek cevap anahtarı,
// referans olarak) saklanır.
model ExamResultAnswer {
  id           String       @id @default(cuid())
  examResultId String
  examResult   ExamResult   @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  questionId   String
  question     ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  isCorrect Boolean? // true=Doğru, false=Yanlış, null=Boş

  @@unique([examResultId, questionId])
  @@index([examResultId])
}

// Öğrencinin sınavdaki her kazanım için başarı durumu — "AI Sınıf Röntgeni" ısı
// haritasının veri kaynağıdır.
model StudentAchievementResult {
  id            String         @id @default(cuid())
  examResultId  String
  examResult    ExamResult     @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  achievementId String
  achievement   CurriculumNode @relation(fields: [achievementId], references: [id])

  questionCount Int
  correctCount  Int
  correctRatio  Float // 0 - 1, masteryLevel bu değerden türetilir

  @@unique([examResultId, achievementId])
  @@index([studentId, achievementId])
}

// ---------------------------------------------------------------------------
// OTOMATİK ETÜT (VIP Eğitim / StudySession)
// ---------------------------------------------------------------------------

enum StudySessionStatus {
  AI_SUGGESTED
  TEACHER_APPROVED
  TEACHER_REJECTED
  COMPLETED
  CANCELLED
}

enum StudySessionSource {
  AI_AUTO_ASSIGNED
  MANUAL
}

// Kulüpler / Sosyal Etkinlikler — demo'daki CURRENT_BRANCH.clubs'ın gerçek
// karşılığı. Düz `tenant_isolation` (Devamsızlık/Disiplin/PTA ile aynı desen):
// bir tenant'taki herkes kulüpleri görebilir (öğrenciler katılmak için
// listeler), yalnızca BRANCH_ADMIN ve o kulübün danışmanı (advisorTeacher)
// üye ekleyip/çıkarabilir. `ClubMembership` — StudentGuardian ile aynı
// desende — kendi tenantId'sini TAŞIMAZ; her zaman zaten tenant'a scope
// edilmiş bir Club/StudentProfile üzerinden erişildiği için ayrı bir RLS
// politikasına ihtiyaç duymaz.
model Club {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  description String?

  advisorTeacherId String?
  advisorTeacher   TeacherProfile? @relation(fields: [advisorTeacherId], references: [id])

  members ClubMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model ClubMembership {
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([clubId, studentId])
}

// Servis / Ulaşım Takibi — demo'daki CURRENT_BRANCH.busRoutes'un gerçek
// karşılığı. Kulüpler'in aksine (çoka-çok üyelik) bir öğrenci aynı anda en
// fazla BİR güzergaha binebilir — bu yüzden ayrı bir join tablosu yerine
// `StudentProfile.busRouteId` (nullable tekli FK) kullanılır; bir öğrenciyi
// bir güzergaha "Ekle" onu varsa önceki güzergahından otomatik çıkarır. Düz
// `tenant_isolation` (Devamsızlık/Disiplin/PTA/Kulüpler ile aynı desen):
// yalnızca BRANCH_ADMIN güzergah oluşturup öğrenci atayabilir; STUDENT/PARENT
// yalnızca KENDİ (velisi olduğu öğrencinin) güzergahını görebilir.
model BusRoute {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  driverName  String?
  driverPhone String?
  capacity    Int
  stops       String[]

  students StudentProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Quiz / Pratik Modülü — demo'daki QUIZ_ATTEMPTS'in gerçek karşılığı.
// Demo'nun kendisinde de sorular GERÇEK değildir (`startQuizSession()` her
// soru için rastgele bir doğru şık üretir, gerçek bir soru bankası yoktur) —
// bu ayrım, resmi optik-taranmış sınavları modelleyen Ölçme-Değerlendirme
// (Exam/ExamResult) ile bilinçli olarak korunur. Gerçek olan ve burada
// kalıcı kılınan kısım, denemenin SONUCUDUR (hangi ders/kazanım, kaç doğru/
// kaç soru, ne zaman) — soru üretimi/rastgele doğru şık simülasyonu istemci
// tarafında (demo'daki gibi) kalır, sunucu yalnızca nihai sonucu kaydeder.
model QuizAttempt {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  subject String

  achievementId String?
  achievement   CurriculumNode? @relation(fields: [achievementId], references: [id])

  correctCount Int
  totalCount   Int

  createdAt DateTime @default(now())

  @@index([tenantId, studentId, createdAt])
}

// Aktivite Akışı (Audit Log) — demo'daki `logActivity()`/`ACTIVITY_LOG`'un
// gerçek karşılığı. Muhasebe/Personel/Belgeler gibi HASSAS tablolarla aynı
// `tenant_and_role_isolation` deseni (yalnızca SUPERADMIN/BRANCH_ADMIN) —
// bu akış platformdaki tüm kritik işlemlerin denetim izidir, ACCOUNTING/
// GUIDANCE_COORDINATOR/TEACHER gibi roller bile göremez. `actorLabel` demo'daki
// `currentActorLabel()` gibi YAZMA ANINDA hesaplanıp saklanır (ör.
// "Ayşe Demir (Öğretmen)") — bu sayede kullanıcı silinse/rolü değişse dahi
// geçmiş kayıt anlamını korur.
model AuditLogEntry {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  actorUserId String?
  actorLabel  String

  action String
  detail String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model TeacherAvailabilitySlot {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0=Pazartesi ... 6=Pazar
  startTime String // "14:00"
  endTime   String // "14:40"
  isBooked  Boolean @default(false)

  @@index([teacherId, dayOfWeek, isBooked])
}

model StudySession {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  // Opsiyonel — demo'daki "Eksik Kazanım (opsiyonel)" alanının karşılığı
  // (bkz. task #57). Öğrenci hangi kazanımda zorlandığını bilmeyebilir; bu
  // durumda serbest metin `note` alanı yeterli olur.
  achievementId String?
  achievement   CurriculumNode? @relation(fields: [achievementId], references: [id])
  // Demo'daki "Not" alanının karşılığı (örn. "Denklem kurmada zorlanıyorum").
  note String?

  status StudySessionStatus @default(AI_SUGGESTED)
  source StudySessionSource @default(AI_AUTO_ASSIGNED)

  scheduledStart DateTime
  scheduledEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, teacherId, scheduledStart])
  @@index([studentId, status])
}

// ---------------------------------------------------------------------------
// ÖDEME / TAKSİT
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model PaymentInstallment {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  installmentNo Int
  amount        Decimal       @db.Decimal(10, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        PaymentStatus @default(PENDING)

  paymentProvider       String  @default("ParamPOS")
  providerTransactionId String?

  receipts PaymentReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, dueDate])
  @@index([studentId, installmentNo])
}

enum PaymentMethodType {
  KREDI_KARTI
  BANKA_HAVALESI
  NAKIT
}

// Velinin kayıtlı ödeme yöntemi (Dijital Cüzdan ekranındaki kayıtlı kart /
// havale bilgisi / nakit tercihi). Kart bilgisinin kendisi ParamPOS'ta saklanır;
// burada yalnızca maskelenmiş görüntü ve tokenize referans tutulur.
model PaymentMethod {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  type              PaymentMethodType
  provider          String            @default("ParamPOS")
  maskedCardNumber  String? // örn. "•••• •••• •••• 4831"
  providerCardToken String? // ParamPOS tokenize kart referansı
  isDefault         Boolean           @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId, studentId])
}

enum InstitutionPaymentMethodType {
  KREDI_KARTI
  BANKA_HAVALESI
  NAKIT
  SENET
}

// "Kayıtlı Yöntemler" — demo/seviye360-app.html'deki CURRENT_BRANCH.paymentMethods
// kataloğunun gerçek karşılığı. `PaymentMethod` modeliyle KARIŞTIRILMAMALI:
// o, bir VELİNİN kayıtlı kartı/tercihidir (studentId zorunlu); bu ise ŞUBENİN
// kendi tahsilat araçlarının (banka hesabı/POS/kasa/senet) kurum geneli
// kataloğudur (studentId YOK, yalnızca tenantId). Demo'daki gibi tek bir
// "extra" alanı türe göre farklı anlam taşır: KREDI_KARTI->komisyon oranı,
// BANKA_HAVALESI->IBAN, NAKIT->teslim alma noktası, SENET->vade notu.
model InstitutionPaymentMethod {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type  InstitutionPaymentMethodType
  label String
  extra String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum PaymentReceiptStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
}

// Ödeme Yöntemleri — Bekleyen Dekont Onayları. demo/seviye360-app.html'deki
// CURRENT_BRANCH.paymentReceipts'in gerçek karşılığı: veli banka havalesi
// dekontunu (resim/PDF) yükler, şube personeli Onayla/Reddet ile taksidi
// ödenmiş işaretler. Demo, dosyayı FileReader.readAsDataURL() ile üretip
// yalnızca localStorage'da tutuyordu (gerçek bir dosya sunucusu YOK) — burada
// aynı temsil (base64 data URL) gerçek bir Postgres sütununda saklanır; ayrı
// bir blob depolama servisi bu depoda kasıtlı olarak kapsam dışıdır. Demo'nun
// kendi ~2,5MB istemci-taraflı boyut sınırı uygulama katmanında da uygulanır.
model PaymentReceipt {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentId     String
  student       StudentProfile     @relation(fields: [studentId], references: [id])
  installmentId String
  installment   PaymentInstallment @relation(fields: [installmentId], references: [id])

  fileName String
  mimeType String
  dataUrl  String  @db.Text
  note     String?

  status           PaymentReceiptStatus @default(BEKLIYOR)
  submittedAt      DateTime             @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?

  @@index([tenantId, status])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// MUHASEBE (Yalnızca Şube Yöneticisi ve Muhasebe rolüne açık)
// ---------------------------------------------------------------------------
//
// Bu tablo, RLS tenant izolasyonuna ek olarak rol bazlı bir politika taşır:
// yalnızca `role IN ('SUPERADMIN','BRANCH_ADMIN','ACCOUNTING')` olan
// kullanıcılar okuyabilir/yazabilir (bkz. prisma/rls/README.md). Diğer roller
// (TEACHER, STUDENT, PARENT, GUIDANCE_COORDINATOR) için bu tablo tamamen
// görünmezdir — uygulama katmanında da ayrıca route/menu seviyesinde gizlenir.

enum AccountingEntryType {
  GELIR
  GIDER
}

model AccountingLedgerEntry {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type      AccountingEntryType
  category  String // örn. "Taksit Tahsilatı", "Kira", "Personel Maaşı"
  amount    Decimal             @db.Decimal(10, 2) // her zaman KDV dahil brüt tutar
  entryDate DateTime
  note      String?

  // KDV Kanunu md 17/2-b uyarınca lisanslı eğitim kurumlarının eğitim/öğretim
  // hizmeti gelirleri genelde KDV'den istisnadır — bu yüzden vatRate NULL
  // (istisna/KDV dışı) olabilir. Doluysa `amount` KDV dahil kabul edilir;
  // matrah = amount / (1 + vatRate), kdv = amount - matrah (bkz. lib/tax.ts).
  vatRate         Decimal? @db.Decimal(5, 4)
  // GVK md 94 stopajı (örn. gerçek kişiden kiralanan işyeri kirası %20) —
  // doluysa `amount` kesintiden ÖNCEKİ (brüt/sözleşme) tutardır; kesilen pay
  // muhtasar beyanname ile vergi dairesine, kalanı hak sahibine ödenir.
  withholdingRate Decimal? @db.Decimal(5, 4)

  createdByUserId      String // BRANCH_ADMIN veya ACCOUNTING rolündeki User.id
  relatedInstallmentId String? // varsa ilgili PaymentInstallment.id

  payrollRecord PayrollRecord?

  createdAt DateTime @default(now())

  @@index([tenantId, entryDate])
  @@index([tenantId, type])
}

// ---------------------------------------------------------------------------
// BELGELER: Fatura / Dekont / Senet
// ---------------------------------------------------------------------------
//
// AccountingLedgerEntry ile aynı RLS deseni (tenant_and_role_isolation) —
// yalnızca SUPERADMIN/BRANCH_ADMIN/ACCOUNTING görebilir. Demo'daki
// (demo/seviye360/seviye360-app.html) karşılığı gibi bu üç belge türü
// BİLİNÇLİ OLARAK Kayıt Defteri'ne otomatik yazılmaz — birbirinden bağımsız
// belgelerdir; deftere yansıtmak isteyen kullanıcı Kayıt Defteri'nden ayrıca
// manuel bir kayıt ekler. `no` alanı (örn. "FT-2026-000001") tenant+yıl
// bazında sıralıdır; üretimi apps/web/lib/documents.ts'de retry-on-conflict
// deseniyle yapılır (bkz. lib/enrollment.ts'deki generateStudentNo ile aynı yaklaşım).

model Invoice {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  no           String
  invoiceDate  DateTime
  buyerName    String
  buyerTaxNo   String?
  buyerAddress String?
  items        Json // [{ description: string, quantity: number, unitPrice: number }]

  // AccountingLedgerEntry.vatRate ile aynı anlam: NULL = KDV'den istisna
  // (KDV Kanunu 17/2-b). Doluysa fatura KDV HARİÇ düzenlenir: kdvAmount =
  // subtotal * kdvRate, total = subtotal + kdvAmount (ledger'daki KDV DAHİL
  // tutardan matrah çıkarma yönünün TERSİ — bkz. lib/documents.ts).
  kdvRate   Decimal? @db.Decimal(5, 4)
  subtotal  Decimal  @db.Decimal(10, 2)
  kdvAmount Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  note      String?

  createdByUserId String

  createdAt DateTime @default(now())

  @@unique([tenantId, no])
  @@index([tenantId])
}

enum ReceiptType {
  TAHSILAT
  ODEME
}

enum ReceiptMethod {
  KREDI_KARTI
  BANKA_HAVALESI
  NAKIT
  SENET
}

// "Dekont" — tahsilat veya ödeme makbuzu.
model Receipt {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  no          String
  receiptDate DateTime
  type        ReceiptType
  personName  String
  amount      Decimal       @db.Decimal(10, 2)
  method      ReceiptMethod
  description String?
  note        String?

  createdByUserId String

  createdAt DateTime @default(now())

  @@unique([tenantId, no])
  @@index([tenantId])
}

enum PromissoryNoteStatus {
  ODENMEDI
  ODENDI
}

// "Senet" — borçludan tahsil edilecek/edilmiş kambiyo senedi.
model PromissoryNote {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  no         String
  issueDate  DateTime
  dueDate    DateTime
  debtorName String
  amount     Decimal              @db.Decimal(10, 2)
  note       String?
  status     PromissoryNoteStatus @default(ODENMEDI)
  paidAt     DateTime?

  studentId String?
  student   StudentProfile? @relation(fields: [studentId], references: [id])

  createdByUserId String

  createdAt DateTime @default(now())

  @@unique([tenantId, no])
  @@index([tenantId])
}

// Basitleştirilmiş, gösterim amaçlı bordro hesaplayıcısının çıktısı (bkz.
// lib/payroll.ts) — kümülatif yıllık gelir vergisi dilimi takibi ve asgari
// ücret istisnası GİBİ ayrıntılar burada MODELLENMEMİŞTİR; resmi bir bordro
// motoru değildir. Her kayıt, işveren maliyetini (brüt + işveren payları)
// tek bir "Personel Maaşı" gider kalemi olarak Muhasebe defterine de yazar.
model PayrollRecord {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Tam olarak biri dolu olmalı — öğretmen için teacherId, öğretmen dışı
  // personel (StaffProfile) için staffProfileId. Uygulama katmanında
  // (apps/web/app/api/branch/payroll) doğrulanır VE bir Postgres CHECK
  // constraint'iyle (bkz. bu modelin migration'ındaki
  // "PayrollRecord_teacher_or_staff_check") veritabanı seviyesinde de
  // garanti edilir.
  teacherId String?
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id])

  staffProfileId String?
  staffProfile   StaffProfile? @relation(fields: [staffProfileId], references: [id])

  period String // "2026-07" (YYYY-MM)

  grossSalary               Decimal @db.Decimal(10, 2)
  sgkEmployeeShare          Decimal @db.Decimal(10, 2) // %14
  unemploymentEmployeeShare Decimal @db.Decimal(10, 2) // %1
  incomeTaxWithheld         Decimal @db.Decimal(10, 2) // basitleştirilmiş ilk dilim (%15)
  stampDutyWithheld         Decimal @db.Decimal(10, 2) // %0,759
  netSalary                 Decimal @db.Decimal(10, 2)

  sgkEmployerShare          Decimal @db.Decimal(10, 2) // %20,5
  unemploymentEmployerShare Decimal @db.Decimal(10, 2) // %2
  employerCost              Decimal @db.Decimal(10, 2) // brüt + işveren payları

  ledgerEntryId String?                @unique
  ledgerEntry   AccountingLedgerEntry? @relation(fields: [ledgerEntryId], references: [id])

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([teacherId, period])
  @@unique([staffProfileId, period])
  @@index([tenantId, period])
}

// İletişim — demo'daki `MESSAGES`/`createMessage()`'ın gerçek karşılığı.
// SMS/e-posta kanalları, ekli dosyalar ve hazır şablonlar demo'da yalnızca
// SİMÜLASYONDUR (gerçek bir SMS/e-posta sağlayıcısı yok) — bu ilk sürüm bu
// yüzden yalnızca uygulama-içi (in-app) mesajlaşmayı gerçek veriye bağlar.
// Alıcı bazlı okundu/gizle durumu için ayrı bir join tablosu (MessageRecipient)
// gerekir — ClubMembership ile aynı gerekçe (StudentGuardian gibi kendi
// tenantId'si yoktur, Message'ın RLS'sine güvenir).
model Message {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  senderUserId String
  sender       User   @relation(fields: [senderUserId], references: [id])
  senderLabel  String // actorLabel() ile üretilir, bkz. lib/audit-log.ts

  title         String
  body          String
  audienceLabel String // örn. "Tüm Veliler", "9-A Sınıfı Velileri"

  createdAt DateTime @default(now())

  recipients  MessageRecipient[]
  attachments MessageAttachment[]

  @@index([tenantId, createdAt])
}

// İletişim — dosya eki (task #58). demo'daki iletisimAttachments'in gerçek
// karşılığı: bir mesajın BİRDEN FAZLA eki olabilir (demo'daki gibi çoklu
// dosya seçimi), bu yüzden Message'a doğrudan fileName/mimeType/dataUrl
// EKLENMEZ — PaymentReceipt'ten farklı olarak burada 1 mesaj:N ek ilişkisi
// var. MessageRecipient ile aynı gerekçeyle kendi tenantId'si/RLS'i yoktur,
// Message'ın RLS'sine güvenir (ek her zaman messageId üzerinden erişilir).
model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName String
  mimeType String
  dataUrl  String  @db.Text

  createdAt DateTime @default(now())

  @@index([messageId])
}

// İletişim — Hazır Şablonlar. demo/seviye360-app.html'deki MESSAGE_TEMPLATES'in
// gerçek karşılığı: BRANCH_ADMIN/TEACHER'ın sık kullandığı mesaj/bildirim
// metinlerini kaydedip, yeni mesaj gönderirken başlık+gövdeyi otomatik
// doldurmak için seçebilmesi. Demo'nun aksine varsayılan/önceden dolu
// şablonlar TOHUMLANMAZ — her şube kendi şablonlarını oluşturur.
model MessageTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  kind     String // "bildirim" | "mesaj"
  category String
  title    String
  body     String

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model MessageRecipient {
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime?

  @@id([messageId, userId])
  @@index([userId])
}

enum MentorRequestStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
  TAMAMLANDI
}

// Seviye Mentör (Online Mentörlük) — demo'daki `MENTOR_REQUESTS`'in gerçek
// karşılığı. PtaMeetingRequest ile neredeyse aynı şekil (talep/onay/red),
// iki farkla: (1) mentör ataması StudentProfile.mentorTeacherId üzerinden
// round-robin otomatik yapılır (bkz. app/api/students/[studentId]/mentor),
// veli/öğrenci bir öğretmen SEÇMEZ; (2) demo'daki gibi aylık kota vardır
// (8. Sınıf/12. Sınıf/Mezun -> ayda 2, diğerleri -> ayda 1 — bkz.
// MENTOR_MONTHLY_QUOTA'daki not), bu yüzden ekstra bir TAMAMLANDI durumu
// (mentörün görüşmeyi gerçekleştirdikten sonra işaretlemesi) taşır.
model MentorRequest {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  mentorTeacherId String
  mentorTeacher   TeacherProfile @relation(fields: [mentorTeacherId], references: [id])

  requestedAt DateTime // öğrenci/velinin talep ettiği görüşme tarihi/saati
  note        String?
  status      MentorRequestStatus @default(BEKLIYOR)

  requestedByUserId String // talebi oluşturan STUDENT ya da PARENT kullanıcısı

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([studentId])
  @@index([mentorTeacherId, status])
}
